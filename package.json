{
  "name": "bangk-shield",
  "version": "1.0.0",
  "private": true,
  "description": "Edge-based application layer honeypot for Cloudflare Workers.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build:rules": "node scripts/build-rules.cjs",
    "predev": "npm run build:rules",
    "dev": "wrangler dev",
    "predeploy": "npm run build:rules",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv namespace create BANGK_KV",
    "salt:rotate": "node scripts/rotate-salt.cjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
