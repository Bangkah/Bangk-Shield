{
  "threshold": 5,
  "vectors": {
    "SQLi": {
      "weight": 5,
      "keywords": [
        "union select",
        "' or '1'='1",
        "or 1=1",
        "sleep(",
        "benchmark(",
        "information_schema",
        "xp_cmdshell",
        "waitfor delay"
      ],
      "patterns": [
        "\\bunion\\s+select\\b",
        "\\bor\\s+1\\s*=\\s*1\\b",
        "(\\%27)|(\\-\\-\\s)"
      ]
    },
    "RCE": {
      "weight": 5,
      "keywords": [
        "/bin/bash",
        "/bin/sh",
        "exec(",
        "system(",
        "passthru(",
        "eval(",
        "base64_decode(",
        "wget http",
        "curl http"
      ],
      "patterns": [
        "(;|\\||&&)\\s*(cat|ls|whoami|id|uname)\\b",
        "\\b(wget|curl)\\s+https?:\\/\\/"
      ]
    },
    "SSRF": {
      "weight": 5,
      "keywords": [
        "169.254.169.254",
        "metadata.google.internal",
        "file://",
        "gopher://",
        "dict://",
        "localhost:22",
        "127.0.0.1:"
      ],
      "patterns": [
        "\\b169\\.254\\.169\\.254\\b",
        "\\bmetadata\\.google\\.internal\\b"
      ]
    },
    "LFI": {
      "weight": 4,
      "keywords": [
        "etc/passwd",
        "boot.ini",
        "win.ini",
        "php://filter",
        "php://input",
        "/proc/self/environ"
      ],
      "patterns": [
        "(\\.\\.\\/){2,}",
        "php:\\/\\/(filter|input)"
      ]
    },
    "XSS": {
      "weight": 3,
      "keywords": [
        "<script",
        "onerror=",
        "onload=",
        "javascript:",
        "document.cookie",
        "alert("
      ],
      "patterns": [
        "<\\s*script[^>]*>",
        "on\\w+\\s*=\\s*[\"']"
      ]
    },
    "Recon": {
      "weight": 2,
      "keywords": [
        ".env",
        ".git/config",
        "wp-admin",
        "phpmyadmin",
        "backup.zip",
        "config.php.bak",
        ".htpasswd",
        "server-status"
      ],
      "patterns": [
        "\\/(\\.env|\\.git\\/config|wp-admin|phpmyadmin)(\\/|$)"
      ]
    }
  }
}